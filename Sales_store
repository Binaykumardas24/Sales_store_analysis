-- 10. Are cretain genders buying more specific product categories.
select * from sales

-- Method 1
select gender,product_category,count(product_category) as total_purchase
from sales 
group by gender,product_category
order by gender

-- Method 2
SELECT *
FROM
(
    SELECT gender, product_category
    FROM sales
) AS source_table
PIVOT
(
    COUNT(gender)
    FOR gender IN ([M], [F])
) AS pivot_table
ORDER BY product_category;

